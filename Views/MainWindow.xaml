<Window x:Class="AllRename.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:AllRename.Converters"
        xmlns:models="clr-namespace:AllRename.Models"
        Title="AllRename v1.1"
        Height="800" Width="1300"
        MinHeight="600" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="#FAFAFA">

    <Window.Resources>
        <conv:StatusToColorConverter x:Key="StatusToColor"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <TabControl Margin="8" TabStripPlacement="Top">

        <!-- ══════════════════════════════════════════════════════════
             ONGLET 1 — FICHIERS LOCAUX
        ══════════════════════════════════════════════════════════ -->
        <TabItem Header="📁  Fichiers locaux">
            <Grid Margin="10" DataContext="{x:Static local:App.MainVm}"
                  xmlns:local="clr-namespace:AllRename">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="4"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Sélection dossier -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBox x:Name="PathBox"
                             Text="{Binding SourcePath, UpdateSourceTrigger=PropertyChanged}"
                             Width="680" Margin="0,0,8,0"/>
                    <Button Content="📂 Parcourir..." Click="BrowseFolder_Click" Margin="0,0,8,0"/>
                    <Button Content="▶  Simuler" Command="{Binding SimulateCommand}"
                            Background="#1565C0" Foreground="White" FontWeight="Bold"
                            Padding="14,5" Margin="0,0,6,0"/>
                    <Button Content="✕ Annuler" Command="{Binding CancelSimulateCommand}"
                            Background="#455A64" Foreground="White" Padding="10,5"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>

                <!-- Config TMDB + Plex rapide -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="Clé TMDB :" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#555"/>
                    <TextBox x:Name="TmdbKeyBox" Width="260" Margin="0,0,6,0"
                             ToolTip="Clé gratuite sur themoviedb.org"/>
                    <Button Content="Enregistrer" Click="SaveTmdbKey_Click" Padding="8,3" Margin="0,0,16,0"/>
                    <TextBlock Text="Plex :" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#555"/>
                    <TextBox x:Name="PlexUrlBox" Width="180" Margin="0,0,4,0"
                             ToolTip="ex: http://192.168.1.10:32400"/>
                    <TextBox x:Name="PlexTokenBox" Width="130" Margin="0,0,6,0"
                             ToolTip="X-Plex-Token"/>
                    <Button Content="Tester" Click="TestPlex_Click" Padding="8,3"/>
                </StackPanel>

                <!-- Barre progression -->
                <ProgressBar Grid.Row="3" Height="5" Margin="0,0,0,6"
                             Value="{Binding ProgressValue}" Maximum="{Binding ProgressMax}"/>

                <!-- DataGrid simulation -->
                <DataGrid Grid.Row="4"
                          ItemsSource="{Binding FileEntries}"
                          AutoGenerateColumns="False" IsReadOnly="False"
                          CanUserAddRows="False" CanUserDeleteRows="False"
                          GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                          RowHeight="24" FontSize="12">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="✓"
                            Binding="{Binding IsIncluded, UpdateSourceTrigger=PropertyChanged}"
                            Width="30" IsReadOnly="False"/>
                        <DataGridTextColumn Header="Fichier source"
                            Binding="{Binding SourceName}" Width="280" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="ToolTip" Value="{Binding SourcePath}"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Nouveau nom"
                            Binding="{Binding NewName, UpdateSourceTrigger=PropertyChanged}"
                            Width="*" IsReadOnly="False"/>
                        <DataGridTemplateColumn Header="Statut" Width="90" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Status}"
                                               Foreground="{Binding Status, Converter={StaticResource StatusToColor}}"
                                               FontWeight="SemiBold" HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Erreur"
                            Binding="{Binding ErrorMessage}" Width="200" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#757575"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Statut -->
                <TextBlock Grid.Row="5" Text="{Binding StatusMessage}"
                           Margin="0,6,0,0" FontStyle="Italic" Foreground="#546E7A"
                           TextTrimming="CharacterEllipsis"/>

                <!-- Boutons action -->
                <StackPanel Grid.Row="6" Orientation="Horizontal"
                            HorizontalAlignment="Right" Margin="0,8,0,0">
                    <TextBlock VerticalAlignment="Center" Margin="0,0,12,0"
                               Foreground="#888" FontSize="11"
                               Text="{Binding FileEntries.Count, StringFormat={}{0} fichier(s)}"/>
                    <Button Content="↩ Annuler (Ctrl+Z)" Command="{Binding RollbackCommand}"
                            Background="#546E7A" Foreground="White" Padding="10,5" Margin="0,0,10,0"/>
                    <Button Content="✓  Renommer les fichiers sélectionnés"
                            Command="{Binding ExecuteRenameCommand}"
                            Background="#2E7D32" Foreground="White"
                            FontWeight="Bold" FontSize="13" Padding="18,7"/>
                </StackPanel>
            </Grid>
        </TabItem>

        <!-- ══════════════════════════════════════════════════════════
             ONGLET 2 — TORRENTS (qBittorrent / Transmission)
        ══════════════════════════════════════════════════════════ -->
        <TabItem Header="⬇  Torrents">
            <Grid Margin="10" DataContext="{x:Static local2:App.TorrentVm}"
                  xmlns:local2="clr-namespace:AllRename">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- Connexion -->
                    <RowDefinition Height="Auto"/>  <!-- Statut -->
                    <RowDefinition Height="4"/>
                    <RowDefinition Height="*"/>     <!-- Split: torrents | fichiers -->
                    <RowDefinition Height="Auto"/>  <!-- Boutons -->
                </Grid.RowDefinitions>

                <!-- Barre de connexion -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="Client :" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#555"/>
                    <ComboBox x:Name="ClientSelector" Width="130" Margin="0,0,10,0"
                              SelectedIndex="0" SelectionChanged="ClientSelector_Changed">
                        <ComboBoxItem Content="qBittorrent"/>
                        <ComboBoxItem Content="Transmission"/>
                    </ComboBox>
                    <TextBlock Text="URL :" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#555"/>
                    <TextBox x:Name="TorrentUrlBox"
                             Text="{Binding ClientUrl, UpdateSourceTrigger=PropertyChanged}"
                             Width="220" Margin="0,0,8,0"
                             ToolTip="qBittorrent: http://localhost:8080 | Transmission: http://localhost:9091"/>
                    <TextBlock Text="Utilisateur :" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#555"/>
                    <TextBox x:Name="TorrentUserBox"
                             Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                             Width="100" Margin="0,0,6,0"/>
                    <TextBlock Text="Mot de passe :" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#555"/>
                    <PasswordBox x:Name="TorrentPassBox" Width="100" Margin="0,0,10,0"
                                 PasswordChanged="TorrentPass_Changed"/>
                    <Button Content="🔌 Connecter" Command="{Binding ConnectCommand}"
                            Background="#1565C0" Foreground="White"
                            FontWeight="Bold" Padding="12,5" Margin="0,0,6,0"/>
                    <Button Content="↻ Actualiser" Command="{Binding RefreshCommand}"
                            Padding="10,5"/>
                </StackPanel>

                <!-- Statut connexion -->
                <TextBlock Grid.Row="1" Text="{Binding StatusMessage}"
                           FontStyle="Italic" Foreground="#546E7A" Margin="0,0,0,4"
                           TextTrimming="CharacterEllipsis"/>

                <!-- Split: liste torrents (gauche) | fichiers (droite) -->
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="360"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Liste des torrents -->
                    <DockPanel Grid.Column="0">
                        <TextBlock DockPanel.Dock="Top" Text="TORRENTS ACTIFS"
                                   FontWeight="SemiBold" FontSize="11" Foreground="#888"
                                   Margin="0,0,0,4"/>
                        <DataGrid ItemsSource="{Binding Torrents}"
                                  SelectedItem="{Binding SelectedTorrent, Mode=TwoWay}"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" CanUserDeleteRows="False"
                                  SelectionMode="Single"
                                  GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                                  RowHeight="24" FontSize="11">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Nom" Binding="{Binding Name}" Width="*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="ToolTip" Value="{Binding SavePath}"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="%" Binding="{Binding ProgressLabel}" Width="48" IsReadOnly="True"/>
                                <DataGridTemplateColumn Header="État" Width="80" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding State}" VerticalAlignment="Center"
                                                       HorizontalAlignment="Center" FontSize="10"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>

                    <!-- Séparateur -->
                    <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                                  Background="#E0E0E0" ResizeDirection="Columns"/>

                    <!-- Fichiers du torrent sélectionné -->
                    <DockPanel Grid.Column="2">
                        <TextBlock DockPanel.Dock="Top" Text="FICHIERS DU TORRENT SÉLECTIONNÉ"
                                   FontWeight="SemiBold" FontSize="11" Foreground="#888"
                                   Margin="6,0,0,4"/>
                        <DataGrid ItemsSource="{Binding SelectedFiles}"
                                  AutoGenerateColumns="False" IsReadOnly="False"
                                  CanUserAddRows="False" CanUserDeleteRows="False"
                                  GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                                  RowHeight="24" FontSize="11" Margin="6,0,0,0">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="✓"
                                    Binding="{Binding IsIncluded, UpdateSourceTrigger=PropertyChanged}"
                                    Width="30" IsReadOnly="False"/>
                                <DataGridTextColumn Header="Nom original"
                                    Binding="{Binding OriginalName}" Width="260" IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="ToolTip" Value="{Binding RelativePath}"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Nom suggéré (TMDB)"
                                    Binding="{Binding SuggestedName, UpdateSourceTrigger=PropertyChanged}"
                                    Width="*" IsReadOnly="False"/>
                                <DataGridTemplateColumn Header="Statut" Width="90" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Status}"
                                                       Foreground="{Binding Status, Converter={StaticResource StatusToColor}}"
                                                       FontWeight="SemiBold" HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="%" Binding="{Binding Progress, StringFormat={}{0:P0}}"
                                    Width="48" IsReadOnly="True"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Grid>

                <!-- Boutons action torrents -->
                <StackPanel Grid.Row="4" Orientation="Horizontal"
                            HorizontalAlignment="Right" Margin="0,8,0,0">
                    <Button Content="🔍  Analyser TMDB"
                            Command="{Binding AnalyseFilesCommand}"
                            Background="#1565C0" Foreground="White"
                            FontWeight="Bold" Padding="14,6" Margin="0,0,10,0"/>
                    <Button Content="✓  Appliquer renommage dans le client"
                            Command="{Binding ApplyRenameCommand}"
                            Background="#2E7D32" Foreground="White"
                            FontWeight="Bold" FontSize="13" Padding="18,7"/>
                </StackPanel>
            </Grid>
        </TabItem>

    </TabControl>
</Window>
